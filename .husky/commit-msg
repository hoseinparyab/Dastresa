#!/usr/bin/env sh
# Enforce Conventional Commits (see docs/CONTRIBUTING.md#commit-messages).
export NO_COLOR=1
export FORCE_COLOR=0

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  MSG_FILE="$(git rev-parse --git-path COMMIT_EDITMSG 2>/dev/null)"
fi

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg: commit message file not found" >&2
  exit 1
fi

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN="$ROOT/node_modules/.bin"

if [ ! -x "$BIN/commitlint" ] && [ ! -f "$BIN/commitlint" ]; then
  echo "commit-msg: commitlint not found — run npm install" >&2
  exit 1
fi

# Pipe the file so commitlint never opens interactive stdin ("--- input ---")
if ! "$BIN/commitlint" --config "$ROOT/commitlint.config.js" < "$MSG_FILE"; then
  echo "" >&2
  echo "Use: type(scope): subject" >&2
  echo "  types:  feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
  echo "  scopes: toolbar|popup|onboarding|settings|a11y|i18n|ui|core|…" >&2
  echo "  example: feat(toolbar): improve collapsed chip for fa/en" >&2
  echo "  guide:   docs/CONTRIBUTING.md#commit-messages" >&2
  exit 1
fi
